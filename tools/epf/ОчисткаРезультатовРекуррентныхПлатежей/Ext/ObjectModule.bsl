#Область ПрограммныйИнтерфейс

// Возвращает количество записей регистра, подлежащих удалению.
//
// Параметры:
//  ДатаОтсечения - Дата - записи с периодом строго меньше этой даты будут удалены.
//
// Возвращаемое значение:
//  Число
//
Функция КоличествоЗаписейКУдалению(ДатаОтсечения) Экспорт
	
	ИмяМетода = "ОчисткаРезультатовРекуррентныхПлатежей.КоличествоЗаписейКУдалению";
	ОбщегоНазначенияКлиентСервер.ПроверитьПараметр(ИмяМетода, "ДатаОтсечения", ДатаОтсечения, Тип("Дата"));
	ОбщегоНазначенияКлиентСервер.Проверить(
		ЗначениеЗаполнено(ДатаОтсечения),
		"Не указана дата отсечения.",
		ИмяМетода);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК КоличествоЗаписей
		|ИЗ
		|	РегистрСведений.РезультатыРекуррентныхПлатежей КАК РезультатыРекуррентныхПлатежей
		|ГДЕ
		|	РезультатыРекуррентныхПлатежей.Период < &ДатаОтсечения";
	Запрос.УстановитьПараметр("ДатаОтсечения", ДатаОтсечения);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.КоличествоЗаписей;
	
КонецФункции

// Удаляет одну порцию записей регистра без регистрации в DWH и планах обмена.
//
// Параметры:
//  ДатаОтсечения - Дата - записи с периодом строго меньше этой даты будут удалены.
//  РазмерПорции - Число - максимальное количество записей в порции.
//
// Возвращаемое значение:
//  Число - фактически удалено записей в этой порции.
//
Функция УдалитьПорциюЗаписей(ДатаОтсечения, РазмерПорции) Экспорт
	
	ИмяМетода = "ОчисткаРезультатовРекуррентныхПлатежей.УдалитьПорциюЗаписей";
	ОбщегоНазначенияКлиентСервер.ПроверитьПараметр(ИмяМетода, "ДатаОтсечения", ДатаОтсечения, Тип("Дата"));
	ОбщегоНазначенияКлиентСервер.ПроверитьПараметр(ИмяМетода, "РазмерПорции", РазмерПорции, Тип("Число"));
	ОбщегоНазначенияКлиентСервер.Проверить(
		ЗначениеЗаполнено(ДатаОтсечения),
		"Не указана дата отсечения.",
		ИмяМетода);
	ОбщегоНазначенияКлиентСервер.Проверить(
		РазмерПорции > 0,
		"Размер порции должен быть больше нуля.",
		ИмяМетода);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	ШаблонТекстаЗапроса =
		"ВЫБРАТЬ ПЕРВЫЕ %1
		|	РезультатыРекуррентныхПлатежей.Период КАК Период,
		|	РезультатыРекуррентныхПлатежей.БанковскаяКарта КАК БанковскаяКарта,
		|	РезультатыРекуррентныхПлатежей.МФО КАК МФО,
		|	РезультатыРекуррентныхПлатежей.Предмет КАК Предмет,
		|	РезультатыРекуррентныхПлатежей.ИдентификаторПлатежа КАК ИдентификаторПлатежа
		|ИЗ
		|	РегистрСведений.РезультатыРекуррентныхПлатежей КАК РезультатыРекуррентныхПлатежей
		|ГДЕ
		|	РезультатыРекуррентныхПлатежей.Период < &ДатаОтсечения";
	Запрос.Текст = СтрШаблон(ШаблонТекстаЗапроса, Формат(РазмерПорции, "ЧГ="));
	Запрос.УстановитьПараметр("ДатаОтсечения", ДатаОтсечения);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат 0;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	КоличествоУдаленных = 0;
	
	Пока Выборка.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений.РезультатыРекуррентныхПлатежей.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Период.Установить(Выборка.Период);
		НаборЗаписей.Отбор.БанковскаяКарта.Установить(Выборка.БанковскаяКарта);
		НаборЗаписей.Отбор.МФО.Установить(Выборка.МФО);
		НаборЗаписей.Отбор.Предмет.Установить(Выборка.Предмет);
		НаборЗаписей.Отбор.ИдентификаторПлатежа.Установить(Выборка.ИдентификаторПлатежа);
		
		ОтключитьРегистрациюУдаления(НаборЗаписей);
		НаборЗаписей.Записать();
		
		КоличествоУдаленных = КоличествоУдаленных + 1;
		
	КонецЦикла;
	
	Возврат КоличествоУдаленных;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОтключитьРегистрациюУдаления(НаборЗаписей)
	
	НаборЗаписей.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектовDWH", Истина);
	НаборЗаписей.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов");
	НаборЗаписей.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения");
	НаборЗаписей.ОбменДанными.Получатели.АвтоЗаполнение = Ложь;
	
КонецПроцедуры

#КонецОбласти
