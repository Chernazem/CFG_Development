#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДатаОтсечения = Дата(2026, 1, 1);
	РазмерПорции = 2000;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Подсчитать(Команда)
	
	КоличествоЗаписей = КоличествоЗаписейКУдалениюНаСервере();
	ТекстРезультата = СтрШаблон(
		"К удалению: %1 записей регистра ""Результаты рекуррентных платежей"" с периодом раньше %2.",
		Формат(КоличествоЗаписей, "ЧН=0; ЧГ="),
		Формат(ДатаОтсечения, "ДЛФ=D"));
	
КонецПроцедуры

&НаКлиенте
Процедура Удалить(Команда)
	
	Если УдалениеВыполняется Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоЗаписей = КоличествоЗаписейКУдалениюНаСервере();
	Если КоличествоЗаписей = 0 Тогда
		ТекстРезультата = "Записей для удаления не найдено.";
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = СтрШаблон(
		"Будет удалено %1 записей регистра ""Результаты рекуррентных платежей"" с периодом раньше %2.
		|Удаление не регистрируется в DWH. Продолжить?",
		Формат(КоличествоЗаписей, "ЧН=0; ЧГ="),
		Формат(ДатаОтсечения, "ДЛФ=D"));
	
	ОписаниеОповещения = Новый ОписаниеОповещения("УдалитьПослеПодтверждения", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура Остановить(Команда)
	
	ОстановитьУдаление = Истина;
	ТекстРезультата = ТекстРезультата + Символы.ПС + "Остановка после текущей порции...";
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УдалитьПослеПодтверждения(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	УдаленоВсего = 0;
	ОстановитьУдаление = Ложь;
	УдалениеВыполняется = Истина;
	ТекстРезультата = "Удаление запущено...";
	
	ПодключитьОбработчикОжидания("УдалитьСледующуюПорцию", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСледующуюПорцию()
	
	Если ОстановитьУдаление Тогда
		УдалениеВыполняется = Ложь;
		ТекстРезультата = СтрШаблон(
			"Удаление остановлено. Удалено записей: %1.",
			Формат(УдаленоВсего, "ЧН=0; ЧГ="));
		Возврат;
	КонецЕсли;
	
	КоличествоВПорции = УдалитьПорциюНаСервере();
	УдаленоВсего = УдаленоВсего + КоличествоВПорции;
	
	Если КоличествоВПорции = 0 Тогда
		УдалениеВыполняется = Ложь;
		ТекстРезультата = СтрШаблон(
			"Удаление завершено. Удалено записей: %1.",
			Формат(УдаленоВсего, "ЧН=0; ЧГ="));
		Возврат;
	КонецЕсли;
	
	ТекстРезультата = СтрШаблон(
		"Удалено записей: %1. Обработка следующей порции...",
		Формат(УдаленоВсего, "ЧН=0; ЧГ="));
	
	ПодключитьОбработчикОжидания("УдалитьСледующуюПорцию", 0.1, Истина);
	
КонецПроцедуры

&НаСервере
Функция КоличествоЗаписейКУдалениюНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ОбработкаОбъект.КоличествоЗаписейКУдалению(ДатаОтсечения);
	
КонецФункции

&НаСервере
Функция УдалитьПорциюНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ОбработкаОбъект.УдалитьПорциюЗаписей(ДатаОтсечения, РазмерПорции);
	
КонецФункции

#КонецОбласти
