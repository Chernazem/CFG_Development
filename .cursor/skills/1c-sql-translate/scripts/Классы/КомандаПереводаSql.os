&Опция(Имя = "schema-root", Описание = "Путь к каталогу schema снимка *_dbschema")
&ТСтрока
&ПоУмолчанию("")
Перем КореньСхемы;

&Опция(Имя = "sql", Описание = "Текст SQL для перевода")
&ТСтрока
&ПоУмолчанию("")
Перем ТекстSql;

&Опция(Имя = "sql-file", Описание = "Файл с текстом SQL для перевода")
&ТСтрока
&ПоУмолчанию("")
Перем ФайлSql;

&Пластилин
Перем КаталогСхемы;

&ВыполнениеКоманды
Процедура ВыполнитьПеревод() Экспорт

	Если Не ЗначениеЗаполнено(КореньСхемы) Тогда
		ВызватьИсключение "Укажите --schema-root";
	КонецЕсли;

	ИсходныйSql = ПолучитьТекстSql();
	Если Не ЗначениеЗаполнено(ИсходныйSql) Тогда
		ВызватьИсключение "Укажите --sql или --sql-file";
	КонецЕсли;

	Результат = Перевести(КореньСхемы, ИсходныйSql);
	Сообщить(ОбъектВJSON(Результат));

КонецПроцедуры

Функция Перевести(ПутьКСхеме, ИсходныйSql) Экспорт

	КаталогСхемы.Инициализировать(ПутьКСхеме);
	Возврат ПеревестиSql(ИсходныйSql);

КонецФункции

Функция ПолучитьТекстSql()

	Если ЗначениеЗаполнено(ФайлSql) Тогда
		Файл = Новый Файл(ФайлSql);
		Если Не Файл.Существует() Тогда
			ВызватьИсключение "Файл SQL не найден: " + ФайлSql;
		КонецЕсли;
		Чтение = Новый ЧтениеТекста(ФайлSql, КодировкаТекста.UTF8);
		Попытка
			Текст = Чтение.Прочитать();
		Исключение
			Чтение.Закрыть();
			ВызватьИсключение;
		КонецПопытки;
		Чтение.Закрыть();
		Возврат Текст;
	КонецЕсли;

	Возврат ТекстSql;

КонецФункции

Функция ПеревестиSql(ИсходныйSql)

	Таблицы = Новый Соответствие;
	Поля = Новый Соответствие;
	Пропущенные = Новый Массив;

	ИменаТаблиц = НайтиИменаТаблиц(ИсходныйSql);
	Для Каждого ИмяТаблицы Из ИменаТаблиц Цикл
		Если ЭтоСлужебноеИмя(ИмяТаблицы) Тогда
			ДобавитьУникальное(Пропущенные, ИмяТаблицы);
			Продолжить;
		КонецЕсли;

		Карточка = КаталогСхемы.КарточкаТаблицы(ИмяТаблицы);
		Если Карточка = Неопределено Тогда
			ДобавитьУникальное(Пропущенные, ИмяТаблицы);
			Продолжить;
		КонецЕсли;

		Метка = КаталогСхемы.МеткаТаблицы1С(ИмяТаблицы);
		Таблицы.Вставить(ИмяТаблицы, Метка);

		Для Каждого КлючИЗначение Из КаталогСхемы.ПоляТаблицы(ИмяТаблицы) Цикл
			ИмяПоляХранения = КлючИЗначение.Ключ;
			Имя1С = КаталогСхемы.ИмяПоля1С(ИмяТаблицы, ИмяПоляХранения);
			Если ЗначениеЗаполнено(Имя1С) Тогда
				Поля.Вставить(ИмяПоляХранения, Имя1С);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Переведенный = ИсходныйSql;
	Переведенный = ЗаменитьПоКарте(Переведенный, Таблицы);
	Переведенный = ЗаменитьПоКарте(Переведенный, Поля);

	Результат = Новый Соответствие;
	Результат.Вставить("sql", Переведенный);
	Результат.Вставить("tables", Таблицы);
	Результат.Вставить("fields", Поля);
	Результат.Вставить("skipped", Пропущенные);

	Возврат Результат;

КонецФункции

Функция НайтиИменаТаблиц(ТекстSql)

	Результат = Новый Массив;
	УжеЕсть = Новый Соответствие;

	Шаблон = "_(?:Reference|Document|InfoRg|AccumRg|Const|Enum|Node|BPr|Task|Chrc)[A-Za-z0-9_]*";
	Выражение = Новый РегулярноеВыражение(Шаблон);
	Выражение.ИгнорироватьРегистр = Истина;
	Совпадения = Выражение.НайтиСовпадения(ТекстSql);

	Для Каждого Совпадение Из Совпадения Цикл
		Имя = Совпадение.Значение;
		Если УжеЕсть[Имя] = Истина Тогда
			Продолжить;
		КонецЕсли;
		УжеЕсть.Вставить(Имя, Истина);
		Результат.Добавить(Имя);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЭтоСлужебноеИмя(Имя)

	Если СтрНачинаетсяС(ВРег(Имя), "_Q_") Тогда
		Возврат Истина;
	КонецЕсли;

	Если СтрНачинаетсяС(Имя, "#") Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Функция ЗаменитьПоКарте(Текст, Карта)

	Ключи = Новый Массив;
	Для Каждого КлючИЗначение Из Карта Цикл
		Ключи.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;

	СортироватьПоДлинеУбыв(Ключи);

	Результат = Текст;
	Для Каждого Ключ Из Ключи Цикл
		Значение = Карта[Ключ];
		Если Не ЗначениеЗаполнено(Значение) Тогда
			Продолжить;
		КонецЕсли;
		Результат = СтрЗаменить(Результат, Ключ, "[" + Значение + "]");
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура СортироватьПоДлинеУбыв(МассивСтрок)

	КоличествоЭлементов = МассивСтрок.Количество();
	Для Индекс1 = 0 По КоличествоЭлементов - 2 Цикл
		Для Индекс2 = Индекс1 + 1 По КоличествоЭлементов - 1 Цикл
			Если СтрДлина(МассивСтрок[Индекс2]) > СтрДлина(МассивСтрок[Индекс1]) Тогда
				Временное = МассивСтрок[Индекс1];
				МассивСтрок[Индекс1] = МассивСтрок[Индекс2];
				МассивСтрок[Индекс2] = Временное;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьУникальное(Массив, Значение)

	Если Массив.Найти(Значение) = Неопределено Тогда
		Массив.Добавить(Значение);
	КонецЕсли;

КонецПроцедуры

Функция ОбъектВJSON(Значение)

	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, " ");
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписи);
	ЗаписатьJSON(ЗаписьJSON, Значение);

	Возврат ЗаписьJSON.Закрыть();

КонецФункции

&КомандаПриложения(
	Имя = "translate t",
	Описание = "Переводит SQL ТЖ (DBMSSQL) в имена метаданных 1С по снимку schema"
)
Процедура ПриСозданииОбъекта() // BSLLS:UnusedLocalMethod-off

	Если КаталогСхемы = Неопределено Тогда
		КаталогСхемы = Новый КаталогСхемы();
	КонецЕсли;

КонецПроцедуры