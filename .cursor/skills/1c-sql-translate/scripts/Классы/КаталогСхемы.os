// Снимок schema: index.json и JSON таблиц.

Перем КореньСхемы;
Перем Индекс;
Перем КэшПолейТаблиц;
Перем КэшОсновныхПолей;

Процедура Инициализировать(ПутьККаталогуSchema) Экспорт

	КореньСхемы = НормализоватьПуть(ПутьККаталогуSchema);
	ПутьИндекса = КореньСхемы + "/index.json";
	ФайлИндекса = Новый Файл(ПутьИндекса);
	Если Не ФайлИндекса.Существует() Тогда
		ВызватьИсключение "Не найден index.json: " + ПутьИндекса;
	КонецЕсли;

	Индекс = ПрочитатьJSONИзФайла(ПутьИндекса);
	КэшПолейТаблиц = Новый Соответствие;
	КэшОсновныхПолей = Новый Соответствие;

КонецПроцедуры

Функция КарточкаТаблицы(ИмяТаблицыХранения) Экспорт

	Возврат Индекс[ИмяТаблицыХранения];

КонецФункции

Функция МеткаТаблицы1С(ИмяТаблицыХранения) Экспорт

	Карточка = КарточкаТаблицы(ИмяТаблицыХранения);
	Если Карточка = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	ИмяТаблицы = ЗначениеПоля(Карточка, "ИмяТаблицы");
	Если Не ЗначениеЗаполнено(ИмяТаблицы) Тогда
		ИмяТаблицы = ЗначениеПоля(Карточка, "Метаданные");
	КонецЕсли;

	Назначение = ЗначениеПоля(Карточка, "Назначение");
	Если ЗначениеЗаполнено(Назначение) И Назначение <> "Основная" Тогда
		Возврат Строка(ИмяТаблицы) + "." + Строка(Назначение);
	КонецЕсли;

	Возврат Строка(ИмяТаблицы);

КонецФункции

Функция ПоляТаблицы(ИмяТаблицыХранения) Экспорт

	Кэш = КэшПолейТаблиц[ИмяТаблицыХранения];
	Если Кэш <> Неопределено Тогда
		Возврат Кэш;
	КонецЕсли;

	Карточка = КарточкаТаблицы(ИмяТаблицыХранения);
	Если Карточка = Неопределено Тогда
		Пустая = Новый Соответствие;
		КэшПолейТаблиц.Вставить(ИмяТаблицыХранения, Пустая);
		Возврат Пустая;
	КонецЕсли;

	Путь = ЗначениеПоля(Карточка, "Путь");
	ПолныйПуть = КореньСхемы + "/" + СтрЗаменить(Строка(Путь), "\", "/");
	ОписаниеТаблицы = ПрочитатьJSONИзФайла(ПолныйПуть);

	Результат = Новый Соответствие;
	Поля = ЗначениеПоля(ОписаниеТаблицы, "Поля");
	Если ТипЗнч(Поля) = Тип("Массив") Тогда
		Для Каждого Поле Из Поля Цикл
			ИмяХранения = ЗначениеПоля(Поле, "ИмяПоляХранения");
			Если Не ЗначениеЗаполнено(ИмяХранения) Тогда
				Продолжить;
			КонецЕсли;
			Имя1С = ЗначениеПоля(Поле, "ИмяПоля");
			Если Имя1С = Неопределено Тогда
				Имя1С = "";
			Иначе
				Имя1С = Строка(Имя1С);
			КонецЕсли;
			Результат.Вставить(Строка(ИмяХранения), Имя1С);
		КонецЦикла;
	КонецЕсли;

	КэшПолейТаблиц.Вставить(ИмяТаблицыХранения, Результат);
	Возврат Результат;

КонецФункции

Функция ИмяПоля1С(ИмяТаблицыХранения, ИмяПоляХранения) Экспорт

	Поля = ПоляТаблицы(ИмяТаблицыХранения);
	Имя = Поля[ИмяПоляХранения];
	Если ЗначениеЗаполнено(Имя) Тогда
		Возврат Имя;
	КонецЕсли;

	Карточка = КарточкаТаблицы(ИмяТаблицыХранения);
	Если Карточка = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если ЗначениеПоля(Карточка, "Назначение") = "Основная" Тогда
		Возврат "";
	КонецЕсли;

	Метаданные = ЗначениеПоля(Карточка, "Метаданные");
	ПоляОсновной = ПоляОсновнойТаблицы(Метаданные);
	ИмяОсновной = ПоляОсновной[ИмяПоляХранения];
	Если ЗначениеЗаполнено(ИмяОсновной) Тогда
		Возврат ИмяОсновной;
	КонецЕсли;

	Возврат "";

КонецФункции

Функция ПоляОсновнойТаблицы(Метаданные)

	Ключ = Строка(Метаданные);
	Кэш = КэшОсновныхПолей[Ключ];
	Если Кэш <> Неопределено Тогда
		Возврат Кэш;
	КонецЕсли;

	Для Каждого КлючИЗначение Из Индекс Цикл
		Карточка = КлючИЗначение.Значение;
		Если ЗначениеПоля(Карточка, "Метаданные") = Метаданные
			И ЗначениеПоля(Карточка, "Назначение") = "Основная" Тогда
			Поля = ПоляТаблицы(КлючИЗначение.Ключ);
			КэшОсновныхПолей.Вставить(Ключ, Поля);
			Возврат Поля;
		КонецЕсли;
	КонецЦикла;

	Пустая = Новый Соответствие;
	КэшОсновныхПолей.Вставить(Ключ, Пустая);
	Возврат Пустая;

КонецФункции

Функция ЗначениеПоля(Объект, ИмяПоля)

	Если ТипЗнч(Объект) = Тип("Соответствие") Тогда
		Возврат Объект[ИмяПоля];
	ИначеЕсли ТипЗнч(Объект) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если Объект.Свойство(ИмяПоля, Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция НормализоватьПуть(Путь)

	Результат = СтрЗаменить(СокрЛП(Путь), "\", "/");
	Пока СтрЗаканчиваетсяНа(Результат, "/") Цикл
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПрочитатьJSONИзФайла(Путь)

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.ОткрытьФайл(Путь, КодировкаТекста.UTF8);
	Попытка
		// Истина - читать объекты JSON как Соответствие (ключи вида _InfoRg...).
		Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
	Исключение
		ЧтениеJSON.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	ЧтениеJSON.Закрыть();

	Возврат Данные;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта() // BSLLS:UnusedLocalMethod-off

	Индекс = Новый Соответствие;
	КэшПолейТаблиц = Новый Соответствие;
	КэшОсновныхПолей = Новый Соответствие;

КонецПроцедуры