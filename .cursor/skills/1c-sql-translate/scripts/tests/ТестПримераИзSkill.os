#Использовать asserts
#Использовать ".."

// Пример из SKILL.md навыка 1c-sql-translate.

&Тест
&ОтображаемоеИмя("SKILL.md: перевод _InfoRg26003")
&Тег("1c-sql-translate")
Процедура ПереводПримераИзSkill() Экспорт

	КореньAiRules = Новый Файл(ТекущийКаталог()).ПолноеИмя;
	КаталогФикстуры = Путь(КореньAiRules, "plugin", "skills", "1c-sql-translate", "scripts");
	КаталогФикстуры = Путь(КаталогФикстуры, "fixtures", "skill-example");
	КаталогСхемы = Путь(КаталогФикстуры, "schema");
	ФайлSql = Путь(КаталогФикстуры, "input.sql");
	ФайлОжидаемого = Путь(КаталогФикстуры, "expected.json");

	Ожидаем.Что(
		Новый Файл(ФайлSql).Существует(),
		"Не найдена фикстура input.sql (запускайте oneunit из корня ai_rules)"
	).ЭтоИстина();

	Переводчик = Новый КомандаПереводаSql();
	Результат = Переводчик.Перевести(КаталогСхемы, ПрочитатьТекстФайла(ФайлSql));
	Ожидаемое = ПрочитатьJSONИзФайла(ФайлОжидаемого);

	ОжидаемыйSql = НормализоватьПереводыСтрок(Строка(Ожидаемое["sql"]));
	ФактическийSql = НормализоватьПереводыСтрок(Строка(Результат["sql"]));

	Ожидаем.Что(ФактическийSql, "SQL не совпал с expected.json / примером SKILL.md").Равно(ОжидаемыйSql);
	Ожидаем.Что(Результат["tables"]["_InfoRg26003"]).Равно(Ожидаемое["tables"]["_InfoRg26003"]);

КонецПроцедуры

Функция Путь(База, Путь1, Путь2 = Неопределено, Путь3 = Неопределено, Путь4 = Неопределено)

	Результат = ОбъединитьПути(База, Путь1);
	Если Путь2 <> Неопределено Тогда
		Результат = ОбъединитьПути(Результат, Путь2);
	КонецЕсли;
	Если Путь3 <> Неопределено Тогда
		Результат = ОбъединитьПути(Результат, Путь3);
	КонецЕсли;
	Если Путь4 <> Неопределено Тогда
		Результат = ОбъединитьПути(Результат, Путь4);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ПрочитатьТекстФайла(ПутьКФайлу)

	Чтение = Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	Попытка
		Текст = Чтение.Прочитать();
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	Чтение.Закрыть();

	Возврат Текст;

КонецФункции

Функция ПрочитатьJSONИзФайла(ПутьКФайлу)

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.ОткрытьФайл(ПутьКФайлу, КодировкаТекста.UTF8);
	Попытка
		Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
	Исключение
		ЧтениеJSON.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	ЧтениеJSON.Закрыть();

	Возврат Данные;

КонецФункции

Функция НормализоватьПереводыСтрок(Текст)

	Результат = СтрЗаменить(Текст, Символы.ВК + Символы.ПС, Символы.ПС);
	Результат = СтрЗаменить(Результат, Символы.ВК, Символы.ПС);
	Возврат СокрП(Результат);

КонецФункции
